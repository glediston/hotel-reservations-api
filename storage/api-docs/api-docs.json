{
    "openapi": "3.0.0",
    "info": {
        "title": "Hotel Reservations API",
        "description": "API REST para gestão de hotéis, quartos e reservas (desafio técnico Foco Multimídia).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Servidor local (Docker)"
        }
    ],
    "paths": {
        "/reserves": {
            "post": {
                "tags": [
                    "Reservas"
                ],
                "summary": "Cria uma reserva",
                "description": "O total e as diárias são calculados pelo sistema a partir de daily_value. O pagamento é opcional e pode ser parcial, mas não pode ultrapassar o total. Formas de pagamento: 1 = dinheiro, 2 = pix, 3 = cartão.",
                "operationId": "b5c3af9f9d98784e08294b2ac7e196ec",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "hotel_id",
                                    "room_id",
                                    "check_in",
                                    "check_out",
                                    "daily_value",
                                    "guests"
                                ],
                                "properties": {
                                    "hotel_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "room_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "check_in": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2027-01-10"
                                    },
                                    "check_out": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2027-01-13"
                                    },
                                    "daily_value": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 100
                                    },
                                    "guests": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "name",
                                                "last_name",
                                                "phone"
                                            ],
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "example": "Maria"
                                                },
                                                "last_name": {
                                                    "type": "string",
                                                    "example": "Souza"
                                                },
                                                "phone": {
                                                    "type": "string",
                                                    "example": "5571999999999"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "payments": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "method",
                                                "value"
                                            ],
                                            "properties": {
                                                "method": {
                                                    "type": "integer",
                                                    "example": 2,
                                                    "enum": [
                                                        1,
                                                        2,
                                                        3
                                                    ]
                                                },
                                                "value": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 100
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Reserva criada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Reserve"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "O quarto já está reservado em parte do período informado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Este quarto já está reservado de 10/01/2027 a 13/01/2027."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dados inválidos: quarto de outro hotel, datas incorretas, check-in no passado, sem hóspede, forma de pagamento inválida ou pagamento maior que o total",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/reserves/{id}": {
            "get": {
                "tags": [
                    "Reservas"
                ],
                "summary": "Detalha uma reserva",
                "description": "Retorna hóspedes, diárias, pagamentos, saldo e status de pagamento.",
                "operationId": "0f769fd3ea8bb6f58890362ca9fa26d6",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id da reserva",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Reserva encontrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Reserve"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Reserva não encontrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rooms": {
            "get": {
                "tags": [
                    "Quartos"
                ],
                "summary": "Lista os quartos",
                "operationId": "1b492e14cbdc859a446992c209170929",
                "parameters": [
                    {
                        "name": "hotel_id",
                        "in": "query",
                        "description": "Filtra os quartos de um hotel",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número da página (15 itens por página)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada de quartos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Room"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Quartos"
                ],
                "summary": "Cadastra um quarto",
                "operationId": "0fcc821623ab708a9cd94310cad7971f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "hotel_id",
                                    "name"
                                ],
                                "properties": {
                                    "hotel_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Suite Master"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Quarto criado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Room"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dados inválidos (hotel inexistente, nome ausente ou repetido no mesmo hotel)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rooms/{id}": {
            "get": {
                "tags": [
                    "Quartos"
                ],
                "summary": "Detalha um quarto",
                "operationId": "6648acdecabaa361b4a002000e0f9c47",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do quarto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Quarto encontrado, com o hotel",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Room"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Quarto não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Quartos"
                ],
                "summary": "Atualiza o nome de um quarto",
                "description": "Apenas o nome pode ser alterado. O nome deve ser único dentro do hotel.",
                "operationId": "373c3c7b58c51231b14ea7af07ee9036",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do quarto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Suite Luxo"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Quarto atualizado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Room"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Quarto não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Nome ausente ou já usado por outro quarto do mesmo hotel",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Quartos"
                ],
                "summary": "Exclui um quarto",
                "description": "Quartos que possuem reservas não podem ser excluídos.",
                "operationId": "cc27db8b69e5e1d2df63959e66ac4ada",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id do quarto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Quarto excluído (sem conteúdo)"
                    },
                    "404": {
                        "description": "Quarto não encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "O quarto possui reservas e não pode ser excluído",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Room": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "hotel_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Room 1 Hotel 1"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Reserve": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 9
                    },
                    "hotel": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "Hotel Foco Prime"
                            }
                        },
                        "type": "object"
                    },
                    "room": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "Room 1 Hotel 1"
                            }
                        },
                        "type": "object"
                    },
                    "check_in": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-12-20"
                    },
                    "check_out": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-12-23"
                    },
                    "nights": {
                        "type": "integer",
                        "example": 3
                    },
                    "total": {
                        "type": "string",
                        "example": "300.00"
                    },
                    "paid": {
                        "type": "string",
                        "example": "100.00"
                    },
                    "balance": {
                        "type": "string",
                        "example": "200.00"
                    },
                    "payment_status": {
                        "type": "string",
                        "example": "parcial",
                        "enum": [
                            "pendente",
                            "parcial",
                            "quitado"
                        ]
                    },
                    "guests": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "example": "Maria"
                                },
                                "last_name": {
                                    "type": "string",
                                    "example": "Souza"
                                },
                                "phone": {
                                    "type": "string",
                                    "example": "5571999999999"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "dailies": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "date": {
                                    "type": "string",
                                    "format": "date",
                                    "example": "2026-12-20"
                                },
                                "value": {
                                    "type": "string",
                                    "example": "100.00"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "method": {
                                    "type": "integer",
                                    "example": 2
                                },
                                "method_name": {
                                    "type": "string",
                                    "example": "pix"
                                },
                                "value": {
                                    "type": "string",
                                    "example": "100.00"
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Quartos",
            "description": "CRUD de quartos"
        },
        {
            "name": "Reservas",
            "description": "Criação e consulta de reservas"
        }
    ]
}